    "@capacitor/ios": "^8.5.0",
    "@capacitor/motion": "^8.0.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@neondatabase/serverless": "^1.1.0",
